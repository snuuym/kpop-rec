# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# The Makefile does not auto-load .env; export the values into your shell:
#   set -a && source .env && set +a

# ── Last.fm (required) ──────────────────────────────────────────────────────
# The entire data pipeline needs this. Create one at:
#   https://www.last.fm/api/account/create
LASTFM_API_KEY=

# ── Spotify (optional) ──────────────────────────────────────────────────────
# Only needed for two things: resolving track IDs in build_features.py, and
# in-browser playback. The pipeline runs fine without them.
#   https://developer.spotify.com/dashboard
#
# The client ID is public by design — the browser PKCE flow exposes it. The
# secret is used only server-side by build_features.py and must stay secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── MusicBrainz (optional) ──────────────────────────────────────────────────
# MusicBrainz requires a User-Agent identifying the client and a contact.
# Substitute your own before running the release-year pass at any volume.
MUSICBRAINZ_USER_AGENT=kpop-rec/1.0 (https://github.com/snuuym/kpop-rec)

# ── Local server (optional) ─────────────────────────────────────────────────
KPOPREC_HOST=127.0.0.1
KPOPREC_PORT=5000
